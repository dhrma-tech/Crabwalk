# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only
SUPABASE_DB_PASSWORD=             # CLI only (supabase link / db push)
SUPABASE_ACCESS_TOKEN=            # CLI only (scoped personal token)

# Auth (Supabase Auth config, not app code)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=

# AI — web server only (apps/web/src/lib/server/ai, supabase/functions/review-summaries).
# DECISIONS P8-1: travellers → Groq only; Gemini only for staff content drafting. Daily cap: app_config.ai_daily_cap.
GROQ_API_KEY=
GEMINI_API_KEY=
AI_MODEL_INTENT=llama-3.1-8b-instant
AI_MODEL_EXPLAIN=llama-3.3-70b-versatile
AI_MODEL_DRAFT=gemini-3.5-flash-lite
AI_PROVIDER=                      # "mock" = scripted provider for local e2e

# Ola (services/ola-proxy only — never in services/api)
OLA_API_KEY=
OLA_PROXY_URL=                    # web server: deployed ola-proxy Worker URL (address search, directions)

# Context
OPENWEATHER_API_KEY=
TIDESATLAS_API_KEY=               # spec fallback provider; not used while TIDE_PROVIDER=tidecheck
TIDECHECK_API_KEY=
TIDE_PROVIDER=tidecheck         # DECISIONS P3-1

# Prices
AGODA_PARTNER_ID=
AGODA_API_KEY=
AGODA_ENABLED=false
AFFILIATE_INRDEALS_ID=            # spec (BACKEND §12); not used by code yet
AFFILIATE_CUELINKS_ID=            # spec (BACKEND §12); not used by code yet

# Cron Edge Functions check this shared secret (also stored in Vault as cron_secret — docs/DEPLOY.md §2–3).
CRON_SECRET=

# Rate limits (P10): random secret for hashing client IPs into rate-limit keys (never stored raw).
RATE_LIMIT_SALT=

# Push
# P9-3: self-generated (node crypto / web-push); private key only in .env + the trip-nudges function secrets.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                    # https://<site> or mailto: contact (Web Push requirement)

# Tiles
PMTILES_BASE_URL=

# Pipelines (optional): full Postgres URL; overrides the linked project pooler URL + SUPABASE_DB_PASSWORD.
PIPELINE_DB_URL=

# Tests (optional): E2E_SUPABASE=local runs Playwright against the local Supabase stack with seed data.
E2E_SUPABASE=

# Dev-only auth bypass (apps/web/src/lib/devAuth.ts): signed in as a mock staff user, writes skipped.
# Ignored in production builds and on any host other than localhost/127.0.0.1. Set it in .env.local.
DEV_BYPASS_AUTH=false

{
	"name": "@crabwalk/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --check && vite build",
		"preview": "wrangler pages dev .svelte-kit/cloudflare --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && pnpm run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale --emit-ts-declarations --silent",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"e2e": "playwright test",
		"test": "vitest --run --passWithNoTests",
		"gen": "wrangler types"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.29.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"lighthouse": "13.5.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"subset-font": "^2.9.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@lucide/svelte": "^1.59.0",
		"@protomaps/basemaps": "^5.7.2",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.118.0",
		"maplibre-gl": "^6.14.0",
		"pmtiles": "^4.5.0",
		"svelte-dnd-action": "0.9.79",
		"uqr": "0.1.3",
		"zod": "^4.6.7"
	}
}
